{
  "name": "@deepliquidity/shared-types",
  "version": "0.1.1",
  "description": "TypeScript types for the DEEP public API (/v1): tokens, trades, candles, pools, pairs, stats, stocks.",
  "license": "MIT",
  "keywords": [
    "solana",
    "deep",
    "api",
    "types"
  ],
  "homepage": "https://deepliquidity.fun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deep-Liquidity/deep-sdk.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
